# Copy this file to .env and fill in your key. .env is gitignored; this file is NOT.
# Never put a real key in this file — it gets committed and pushed publicly.
#
# Used only by netlify/functions/* (server-side). Never prefix this with VITE_ —
# that would bundle it into client-side JS and leak it to every visitor.
GEMINI_API_KEY=your_google_generative_ai_api_key
